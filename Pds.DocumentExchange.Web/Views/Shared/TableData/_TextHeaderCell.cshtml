@model string

<th>
    <span class="tab-header products-table-header">@Model
        @{
            if (!string.IsNullOrWhiteSpace(@Model))
            {
                <svg class="sort-icon" width="22" height="22" focusable="false" aria-hidden="true" role="img" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path id="default-sort-direction" d="M8.1875 9.5L10.9609 3.95703L13.7344 9.5H8.1875Z M13.7344 12.0781L10.9609 17.6211L8.1875 12.0781H13.7344Z" fill="currentColor"></path>
                </svg>
            }
        }      
    </span>
</th>