@model Pds.DocumentExchange.Web.Models.Organisation.ReceivedDocument

<tr class="searchable-table-row" id="file-@Model.PositionInRenderedList">
    <partial name="/Views/Shared/TableData/_ExchangeDocumentSelectionCell.cshtml" />
    <td class="sortable-td" style="vertical-align: top;">
        <partial name="/Views/Shared/TableData/_ExchangeDocumentDownloadLink.cshtml" />
        <br />
        @Model.DisplayReceivedDateTime
    </td>
    <partial name="/Views/Shared/TableData/_TextCell.cshtml" model="@Model.RecipientOrganisationName" />
    <partial name="/Views/Shared/TableData/_TextCell.cshtml" model="@Model.ProductName" />
    <partial name="/Views/Shared/TableData/_ExchangeDocumentStatusCell.cshtml" />
</tr>