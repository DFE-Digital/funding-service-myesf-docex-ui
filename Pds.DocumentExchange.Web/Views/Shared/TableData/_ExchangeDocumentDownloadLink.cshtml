@using Pds.DocumentExchange.Web.Helpers
@model Pds.DocumentExchange.Web.Models.Shared.ExchangeDocument

<a href="@Url.ActionLink(Model.DownloadActionLink, values: new { documentReferenceString = $"{Model.FileName}|{Model.BatchIdentifier}|{Model.ParentBatchIdentifier}" })"
   title="Download @Model.FileName @ContentHelper.GetFileExtensionNote(Model.FileName)">
    @Html.Raw(ContentHelper.InsertBreaksIntoFileName(Model.FileName))
</a>