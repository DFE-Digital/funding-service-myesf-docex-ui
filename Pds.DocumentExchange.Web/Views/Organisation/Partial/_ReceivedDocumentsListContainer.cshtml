@using Pds.DocumentExchange.Web.Controllers
@using Pds.DocumentExchange.Web.Models.Organisation
@model ReceivedDocuments

<div>
    <fieldset>
        <legend id="document-list" class="visuallyhidden">
            @Model.TableCaption
        </legend>

        <partial name="~/Areas/Lists/Views/_FilterResultsAlert.cshtml" />

        <div class="form-group">
            <table data-checkboxes>
                <caption class="visuallyhidden">@Model.TableCaption</caption>
                <partial name="@Model.TableHeaderPartialName" />
                <tbody id="list-items-container">
                    <partial name="~/Areas/Lists/Views/_Items.cshtml" />
                </tbody>
            </table>
            <partial name="~/Areas/Lists/Views/_Pagination.cshtml" />
        </div>

        @if (Model.ShowParentView)
        {
            <div class="form-group">
                <button type="submit" formaction="@Url.ActionLink(nameof(OrganisationController.ReceivedDocumentsDownload))"
                        class="button" role="button" title="Download selected documents" data-error-source="download" download>
                    Download selected documents
                </button>
            </div>
        }

        <partial name="/Views/Shared/_BackToTopLink.cshtml" />
    </fieldset>
</div>