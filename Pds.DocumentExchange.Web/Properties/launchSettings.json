{
  "profiles": {
    "Pds.DocumentExchange.Web": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "document-exchange",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "applicationUrl": "https://myesf.local:44316;http://myesf.local:62861"
    },
    "Container (Dockerfile)": {
        "commandName": "Docker",
        "launchBrowser": true,
        "launchUrl": "{Scheme}://myesf.local:{ServicePort}/document-exchange",
        "environmentVariables": {
            "ASPNETCORE_HTTPS_PORTS": "44316",
            "ASPNETCORE_HTTP_PORTS": "62861"
        },
        "publishAllPorts": true,
        "useSSL": true,
        "httpPort": 62861,
        "sslPort": 44316
    }
  },
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://myesf.local:62861",
      "sslPort": 44316
    }
  }
}