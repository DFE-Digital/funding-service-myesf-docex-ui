@using Pds.DocumentExchange.Web.Controllers
@using Pds.DocumentExchange.Web.Models.Agency
@model DeleteDocumentsConfirmation

<form method="get" class="form" action="@Url.ActionLink(nameof(AgencyController.DownloadDocuments))">
    <div class="form-group">
        <div class="govuk-box-highlight">
            <h1 class="bold-xlarge">@Model.ContentTitle</h1>
        </div>
    </div>

    <partial name="~/Areas/Lists/Views/_List.cshtml" />

    <div class="form-group">
        <button class="button" type="submit">Download documents</button>
    </div>
</form>