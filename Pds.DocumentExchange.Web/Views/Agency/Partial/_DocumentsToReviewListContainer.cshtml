@using Pds.DocumentExchange.Web.Controllers
@using Pds.DocumentExchange.Web.Models.Agency
@model DocumentsToReview

<div>
    <fieldset>
        <legend id="document-list" class="visuallyhidden">
            @Model.TableCaption
        </legend>

        <partial name="~/Areas/Lists/Views/_FilterResultsAlert.cshtml" />

        <div class="form-group">
            <table data-checkboxes>
                <caption class="visuallyhidden">@Model.TableCaption</caption>
                <thead>
                    <tr class="first">
                        <partial name="/Views/Shared/TableData/_HiddenHeaderCell.cshtml"
                                 model='"Select and deselect this document"' />
                        <partial name="/Views/Shared/TableData/_TextHeaderCell.cshtml"
                                 model='"Document name"' />
                        <partial name="/Views/Shared/TableData/_TextHeaderCell.cshtml"
                                 model='"Document name error"' />
                        <partial name="/Views/Shared/TableData/_TextHeaderCell.cshtml"
                                 model='"Document type"' />
                    </tr>
                </thead>
                <tbody id="list-items-container">
                    <partial name="~/Areas/Lists/Views/_Items.cshtml" />
                </tbody>
            </table>
            <partial name="~/Areas/Lists/Views/_Pagination.cshtml" />
        </div>

        <div class="form-group">
            <button type="submit" formaction="@Url.ActionLink(nameof(AgencyController.DocumentsToReviewReport))"
                    class="button" role="button" title="Download selected document names and errors (ODS)" data-error-source="download" download>
                Download selected document names and errors (<abbr title="Open Document Sheet">ODS</abbr>)
            </button>
        </div>

        <div class="form-group">
            <input type="hidden" name="@nameof(RemoveDocuments.EntryAction)" value="@nameof(AgencyController.DocumentsToReview)" />
            <button type="submit" formaction="@Url.ActionLink(nameof(AgencyController.RemoveDocumentsAreYouSure))"
                    class="button button-secondary" role="button" title="Remove selected documents" data-error-source="remove">
                Remove selected documents
            </button>
        </div>

        <partial name="/Views/Shared/_BackToTopLink.cshtml" />
    </fieldset>
</div>