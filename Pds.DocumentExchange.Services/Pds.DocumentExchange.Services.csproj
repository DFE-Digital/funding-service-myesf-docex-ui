<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;S1135</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Pds.DocumentExchange.Services.csproj.transform" />
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="Resources\Aspose.Total.lic">
