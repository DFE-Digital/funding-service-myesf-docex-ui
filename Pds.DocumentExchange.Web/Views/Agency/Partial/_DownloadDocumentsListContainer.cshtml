@using Pds.DocumentExchange.Web.Controllers
@using Pds.DocumentExchange.Web.Models.Agency
@using Pds.DocumentExchange.Web.Models.Shared
@model DownloadDocuments

<div>
    <fieldset>
        <div class="form-group">
            <button type="submit" formaction="@Url.ActionLink(nameof(AgencyController.DownloadExchangeDocumentsByFilters))"
                    class="button" role="button" title="Download all filtered documents" data-allow-submit-without-selection="true">
                Download all filtered documents
            </button>
        </div>

        <legend id="document-list" class="visuallyhidden">
            @Model.TableCaption
        </legend>

        <partial name="~/Areas/Lists/Views/_FilterResultsAlert.cshtml" />

        <div class="form-group">
            <table data-checkboxes>
                <caption class="visuallyhidden">@Model.TableCaption</caption>
                <thead>
                    <tr class="first">
                        <partial name="/Views/Shared/TableData/_HiddenHeaderCell.cshtml"
                                 model='"Select and deselect this document"' />
                        <partial name="/Views/Shared/TableData/_TextHeaderCell.cshtml"
                                 model='"Document type"' />
                        <partial name="/Views/Shared/TableData/_TableHeaderCell.cshtml"
                                 model='new TableHeaderCell { Value = "Provider name", CssClasses = "table-header-width-one-quarter" }' />
                        <partial name="/Views/Shared/TableData/_TextHeaderCell.cshtml"
                                 model='"UKPRN"' />
                        <partial name="/Views/Shared/TableData/_TableHeaderCell.cshtml"
                                 model='new TableHeaderCell { Value = "Uploaded", CssClasses = "table-header-width-one-third" }' />
                    </tr>
                </thead>
                <tbody id="list-items-container">
                    <partial name="~/Areas/Lists/Views/_Items.cshtml" />
                </tbody>
            </table>
            <partial name="~/Areas/Lists/Views/_Pagination.cshtml" />
        </div>

        <div class="form-group">
            <button type="submit" formaction="@Url.ActionLink(nameof(AgencyController.DownloadExchangeDocumentList))"
                    class="button" role="button" title="Download selected documents" data-error-source="download">
                Download selected documents
            </button>
        </div>

        @if (Model.UserIsAdvancedAgencyUser)
        {
            <div class="form-group">
                <button type="submit" formaction="@Url.ActionLink(nameof(AgencyController.DeleteDocumentsAreYouSure))"
                        class="button button-secondary" role="button" title="Delete selected documents" data-error-source="delete">
                    Delete selected documents
                </button>
            </div>
        }

        <partial name="/Views/Shared/_BackToTopLink.cshtml" />

    </fieldset>
</div>