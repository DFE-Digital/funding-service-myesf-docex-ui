    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Pds.Core.ApiClient" Version="5.0.2" />
    <PackageReference Include="Pds.Core.CodeAnalysis.StyleCop" Version="2.0.0" />
    <PackageReference Include="Pds.Core.Common" Version="2.0.0" />
    <PackageReference Include="Pds.Core.Documents.Aspose" Version="4.0.2" />
    <PackageReference Include="Pds.Core.Logging" Version="3.0.1" />
  </ItemGroup>
  
</Project>
